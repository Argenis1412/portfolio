# Shared backend and Docker Compose configuration example.
# Compose: copy to .env in the repository root.
# Manual backend: copy to backend/.env and run commands from backend/.
# Frontend configuration is documented separately in frontend/.env.example.

APP_NAME="Portfolio Backend API"
ENVIRONMENT=local
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
# Leave unset to use the origin regex from app/settings.py.
# REGEX_ALLOWED_ORIGINS=^https://your-frontend\.example$

# Optional locally. Production requires Redis and metrics authentication.
# Compose overrides REDIS_URL with its internal Redis service address.
REDIS_URL=
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5
METRICS_BASIC_AUTH_USERNAME=
METRICS_BASIC_AUTH_PASSWORD=

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTLP_ENDPOINT=

TRUSTED_PROXY_DEPTH=1
TRUSTED_PROXY_IPS=

# Used only by the local Grafana container. Set a local password before Compose.
GRAFANA_ADMIN_PASSWORD=
